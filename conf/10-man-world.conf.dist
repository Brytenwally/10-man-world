[worldserver]

################################################################################################################
#    10 Man World - Dungeon Finder
#        Description: lets the leader of a raid group use the Dungeon Finder (random or specific
#                     dungeons) with the whole raid. There is no role check and no queue: the
#                     moment the leader clicks "Join as party" the raid becomes a Dungeon Finder
#                     group and every member is teleported into the selected dungeon.
#                     Parties of up to five and raid (LFR) selections keep the normal behaviour.
#
#        TenManWorld.DungeonFinder.Enable: 1 (Default) enables instant raid queueing
#                               0 = raid groups get the normal "too many members" refusal
#                               Read at startup and on ".reload config".
#
#        TenManWorld.DungeonFinder.MaxMembers: the largest raid allowed to queue. Default 10.
#                                   Five-player dungeons accept this many players from a Dungeon
#                                   Finder raid; every other group keeps the dungeon's own cap.
#                                   Clamped to 5-40. Read at startup and on ".reload config".
#

TenManWorld.DungeonFinder.Enable = 1

TenManWorld.DungeonFinder.MaxMembers = 10

################################################################################################################
#    10 Man World - Random Battleground
#        Description: lets a raid group queue together for the Random Battleground. Every member
#                     still has to pass the normal group checks (same level bracket and faction,
#                     no Deserter, not queued elsewhere, not in a Dungeon Finder group).
#
#        TenManWorld.Battleground.Enable: 1 (Default) lets raid groups queue for Random Battleground
#                                            0 = raids keep the normal group size limit
#
#        TenManWorld.Battleground.MaxMembers: the largest raid allowed to queue. Default 10.
#                                                Never more than the Random Battleground team size
#                                                (battleground_template, 10 by default). Clamped to 5-40.
#
#        TenManWorld.Battleground.LeaderQueuesRaid: 1 (Default) when a raid leader clicks the plain
#                                                      "Join Battle" button for Random Battleground,
#                                                      the whole raid is queued (the 3.3.5 client may
#                                                      not offer "Join as Group" to a raid)
#                                                      0 = only "Join as Group" queues the raid
#
#        All three are read at startup and on ".reload config".
#

TenManWorld.Battleground.Enable = 1

TenManWorld.Battleground.MaxMembers = 10

TenManWorld.Battleground.LeaderQueuesRaid = 1

################################################################################################################
#    10 Man World - Creature modifiers
#        Description: multiplies creature health and damage by where the creature lives and by its rank.
#                     "Elite" covers elites, rares, rare elites and bosses (any creature_template rank but
#                     normal; in dungeons also every dungeon boss). Raids, battlegrounds, arenas and scripted
#                     private instances are not changed. Player pets, totems, triggers, critters and training
#                     dummies are never changed.
#
#                     Health: applied when a creature spawns, respawns or changes entry. A reload changes
#                     creatures spawned after it; already spawned ones keep their health until they respawn.
#                     Damage: applied to the damage a creature deals to players and their pets (melee, spells
#                     and damage over time); takes effect immediately on reload.
#
#                     The multipliers stack (multiply) with the fork's other scalers, such as
#                     CoA.CreatureScaling, CoA.DungeonTuning and Mythic+.
#
#        TenManWorld.CreatureModifiers.Enable: 1 (Default) applies the multipliers below
#                                              0 = creatures keep their normal health and damage
#
#        TenManWorld.CreatureModifiers.<Area>.<Rank>.Health / .Damage: multiplier, 1.0 = unchanged.
#            World.Normal    open world normal creatures        default 4.0 health, 3.0 damage
#            World.Elite     open world rares, elites, bosses   default 2.5 health, 2.0 damage
#            Dungeon.Normal  five-player dungeon non-elites     default 2.5 health, 2.0 damage
#            Dungeon.Elite   five-player dungeon elites/bosses  default 2.0 health, 1.5 damage
#
#        All values are read at startup and on ".reload config".
#

TenManWorld.CreatureModifiers.Enable = 1

TenManWorld.CreatureModifiers.World.Normal.Health = 4.0
TenManWorld.CreatureModifiers.World.Normal.Damage = 3.0

TenManWorld.CreatureModifiers.World.Elite.Health = 2.5
TenManWorld.CreatureModifiers.World.Elite.Damage = 2.0

TenManWorld.CreatureModifiers.Dungeon.Normal.Health = 2.5
TenManWorld.CreatureModifiers.Dungeon.Normal.Damage = 2.0

TenManWorld.CreatureModifiers.Dungeon.Elite.Health = 2.0
TenManWorld.CreatureModifiers.Dungeon.Elite.Damage = 1.5
